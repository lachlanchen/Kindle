# Device/private data
device-backups/

# Downloaded release artifacts and extracted package trees are reproducible from
# the URLs and checksums recorded in docs/package-manifest.md.
downloads/
packages/
staging/

# Local run state
logs/latest-backup.txt
logs/latest-*.txt
logs/winterbreak2-local-server/

# Never add new private handoff identities. Device private keys live in the
# user's .ssh directory; only a selected public key is copied to the Kindle.
Handoff/keys/*_rsa
Handoff/keys/*_ed25519
Handoff/keys/*.pem

# Large Kindle/Amazon package formats if manually dropped into the repo.
*.bin
*.zip
*.tar
*.tar.gz
*.tgz

# Local desktop-app and handoff build output
.venv/
__pycache__/
*.pyc
app/build/
app/dist/
app/build-assets/
Handoff/build/
