          "requirements": []
        },
        {
          "models": ["PW6", "KT6"],
          "firmware": {"min": "5.16.4", "max": "5.17.1.0.4"},
          "requirements": [
            {"key": "blacklisted", "allowed": ["yes"], "label": "This PW6/KT6 route is documented for blacklisted devices"}
          ]
        }
      ],
      "package": {
        "url": "https://kindlemodding.org/jailbreaking/Nosebleed/nosebleed.zip",
        "filename": "nosebleed.zip",
        "archive": "zip",
        "sha256": "",
        "mode": "stage_root"
      },
      "steps": [
        "Prevent automatic updates and enable Airplane mode.",
        "Use Prepare Kindle to back up conflicts and copy the official three-file payload.",
        "Eject, open Browser, and visit https://kindlemodding.org/nosb.",
        "Follow the official on-screen trigger.",
        "Return to Airplane mode immediately after success."
      ],
      "post_note": "Continue with the official post-jailbreak hotfix before reconnecting normally."
    },
    {
      "id": "adbreak",
      "name": "AdBreak",
      "priority": 85,
      "kind": "adbreak",
      "guide_url": "https://kindlemodding.org/jailbreaking/AdBreak/",
      "summary": "Advertisement-based route for registered Kindles that already display Special Offers.",
      "platforms": ["windows", "linux", "macos"],
      "space_guard": "optional",
      "variants": [
        {
          "models": ["PW4", "KT4", "KOA3", "KOA3W32C", "PW5", "PW5SE", "KT5", "KS", "KT6", "PW6"],
          "firmware": {"min": "5.18.1", "max": "5.18.5.0.1"},
          "requirements": [
            {"key": "registered", "allowed": ["yes"], "label": "Kindle must be registered"},
            {"key": "ads", "allowed": ["yes"], "label": "Special Offers must already be downloaded and visible"}
          ]
        }
      ],
      "package": {
        "url": "https://github.com/KindleModding/AdBreak/releases/download/1.1/AdBreak.1.1.zip",
        "filename": "AdBreak.1.1.zip",
        "archive": "zip",
        "sha256": "d4febaff59364f81eb14a974bc2fb09a19d9e8f58745c9e80f46d1f8853e83d3",
        "mode": "adbreak"
      },
      "steps": [
        "Confirm multiple ads are visible in View all ads, then enable Airplane mode.",
        "Connect by USB and use Prepare Kindle; the original .assets folder is backed up first.",
        "Eject, open an ad, and follow the official Bang/Close sequence.",
        "Ignore only the application errors the official guide identifies as expected.",
        "Keep Airplane mode enabled and install the hotfix."
      ],
      "post_note": "Install the official hotfix before allowing normal network access."
    },
