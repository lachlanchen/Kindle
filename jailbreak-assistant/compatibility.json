    {
      "id": "winterbreak",
      "name": "WinterBreak",
      "priority": 85,
      "kind": "stage",
      "guide_url": "https://kindlemodding.org/jailbreaking/WinterBreak/",
      "summary": "Broad software route for registered 5.x Kindles below firmware 5.18.1.",
      "platforms": ["windows", "linux", "macos"],
      "space_guard": "required",
      "variants": [
        {
          "models": ["PW", "PWG", "PW2", "PW2J", "KV", "KT2", "BASIC", "PW3", "KOA", "KT3", "KOA2", "PW4", "KT4", "KOA3", "KOA3W32C", "PW5", "PW5SE", "KT5", "KS", "KT6", "PW6", "KS2", "CS"],
          "firmware": {"max": "5.18.0.2"},
          "requirements": [
            {"key": "registered", "allowed": ["yes"], "label": "Kindle must be registered"}
          ]
        }
      ],
      "package": {
        "url": "https://github.com/KindleModding/WinterBreak/releases/download/v2.1.0/WinterBreak.tar.gz",
        "filename": "WinterBreak.tar.gz",
        "archive": "tar.gz",
        "sha256": "dc04fff5fcb685834cba9f9e95d4818b473d4100b2d40b8bb7c598ad09eb850d",
        "mode": "stage_root"
      },
      "steps": [
        "Register the Kindle and save a working Wi-Fi network.",
        "Enable Airplane mode, restart, connect by USB, and use Prepare Kindle.",
        "Create the reversible OTA space guard so only 50-90 MB remains.",
        "Eject, open Store, allow the documented Wi-Fi step, and run WinterBreak.",
        "Return to Airplane mode and verify documents/JAILBROKEN.txt."
      ],
      "post_note": "The current bootstrap already installs KMC/persistence, KPM, shell integration, and OTA protection. Do not layer a separate legacy hotfix stack over it."
    },
