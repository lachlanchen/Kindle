  "methods": [
    {
      "id": "springbreak",
      "name": "SpringBreak",
      "priority": 100,
      "kind": "runner",
      "guide_url": "https://kindlemodding.org/jailbreaking/SpringBreak/",
      "summary": "Newest official host-assisted route for selected registered Kindles on the listed firmware builds.",
      "platforms": ["windows", "linux", "macos"],
      "space_guard": "forbidden",
      "variants": [
        {
          "models": ["PW4", "KT4", "PW5", "PW5SE", "KT5"],
          "firmware": {"exact": ["5.18.1.1.1", "5.19.2", "5.19.2.0.1"]},
          "requirements": [
            {"key": "registered", "allowed": ["yes"], "label": "Kindle must be registered"}
          ]
        }
      ],
      "package": {
        "url": "https://github.com/KindleModding/SpringBreak/releases/download/v1.2/springbreak.zip",
        "filename": "springbreak.zip",
        "archive": "zip",
        "sha256": "2880cbf765c57c3142f44d2339c4a3c70e3322a0e910f0ed2f698077078315f2",
        "mode": "runner",
        "runners": {
          "windows": ["springbreak.exe"],
          "linux": ["springbreak-linux"],
          "macos": ["springbreak-darwin"]
        }
      },
      "steps": [
        "Remove any old filler files and leave generous free space.",
        "Enable Airplane mode, restart, and connect the Kindle by USB.",
        "Run the official helper from this app and select the detected Kindle.",
        "Follow the official Store/Wi-Fi step promptly.",
        "After success, reconnect and run the helper again for cleanup."
      ],
      "post_note": "Hotfix and KPM are included. Use ;kpm update and ;kpm install koreader."
    },
    {
      "id": "sanctuary",
      "name": "Sanctuary",
      "priority": 95,
      "kind": "web",
      "guide_url": "https://kindlemodding.org/jailbreaking/Sanctuary/",
      "summary": "Browser-based route that can work on unregistered and blacklisted Chromium-based Kindles.",
      "platforms": ["windows", "linux", "macos"],
      "space_guard": "recommended",
      "variants": [
        {
          "models": ["PW4", "KT4", "KOA3", "KOA3W32C", "PW5", "PW5SE", "KT5", "KS", "KT6", "PW6", "KS2", "CS"],
          "firmware": {"min": "5.16.4", "max": "5.18.3"},
          "requirements": [
            {"key": "browser", "allowed": ["chromium"], "label": "Chromium Kindle browser required"}
          ]
        }
      ],
      "steps": [
        "Prevent automatic updates before enabling Wi-Fi.",
        "Open the Kindle browser and use the official Sanctuary compatibility page.",
        "Let port scanning finish, enter the displayed ID exactly, and connect.",
        "Exit Browser, then open Settings, Help, Getting Started.",
        "Wait for the success screen and UI restart."
      ],
      "post_note": "Hotfix and KPM are included. Use ;kpm update and ;kpm install koreader."
    },
    {
